[importlinter]
root_packages =
    application
    config
    domain
    infrastructure
include_external_packages = True

[importlinter:contract:layer-dependencies]
name = Infrastructure may depend on configuration and application; application may depend only on domain
type = layers
layers =
    infrastructure
    config
    application
    domain

[importlinter:contract:configuration-is-independent]
name = Configuration must not depend on runtime layers
type = forbidden
source_modules =
    config
forbidden_modules =
    application
    infrastructure
    domain

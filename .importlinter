[importlinter]
root_packages =
    application
    config
    domain
    infrastructure
include_external_packages = True

[importlinter:contract:layer-dependencies]
name = Infrastructure may depend on configuration; application may depend only on domain
type = layers
layers =
    infrastructure
    config
    application
    domain

[importlinter:contract:configuration-does-not-import-infrastructure]
name = Configuration must not depend on infrastructure adapters
type = forbidden
source_modules =
    config
forbidden_modules =
    infrastructure

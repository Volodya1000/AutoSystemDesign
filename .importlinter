[importlinter]
root_packages =
    application
    config
    domain
    infrastructure
    shared
include_external_packages = True

[importlinter:contract:layer-dependencies]
name = Infrastructure may depend on configuration and application; domain is foundational
type = layers
layers =
    infrastructure
    config | application
    domain | shared

[importlinter:contract:acyclic-infrastructure-siblings]
name = Infrastructure modules and adapters must not form dependency cycles
type = acyclic_siblings
ancestors =
    infrastructure
depth = 10
